# Required: from app.spatius.ai
SPATIUS_API_KEY=
SPATIUS_APP_ID=
# us-west (default) or your region
SPATIUS_REGION=us-west

# Optional: your own OpenAI key. Without it, the call uses 30 free Spatius starter minutes.
OPENAI_API_KEY=

# Optional: where the page starts (the rep can still change everything)
# Buyer: it, finance, owner    Difficulty: easy, realistic, tough    Language: en, es, zh, ar, fr
EXPERT_BUYER=it
EXPERT_DIFFICULTY=realistic
EXPERT_LANG=en
# Your own product and its technical notes, instead of the samples. Write \n for a new line.
# EXPERT_PRODUCT=Acme CRM: a simple CRM for dental clinics. $49 per user per month.
# EXPERT_NOTES=Sign-in: Google single sign-on.\nData: stored in the EU.\nAPI: REST, on the Pro plan.
# PORT=3000
